# Copy this file to `.env` and fill in your values.
# Variables prefixed with REACT_APP_ are exposed to the client bundle by CRA.

# Disable auto-opening browser when running `npm start`
BROWSER=none

# ---- Production-only ----
# Remove sourcemaps from the production bundle
GENERATE_SOURCEMAP=false

# Exposes package.json version via process.env.REACT_APP_VERSION
REACT_APP_VERSION=$npm_package_version

# ---- EmailJS (optional overrides) ----
# Contact.jsx ใช้ค่าเริ่มต้นแบบ hardcoded อยู่ในไฟล์
# ถ้าต้องการให้ override ผ่าน env ให้ refactor Contact.jsx แล้วอ่านตัวแปรด้านล่าง
# REACT_APP_EMAILJS_SERVICE_ID=
# REACT_APP_EMAILJS_TEMPLATE_ID=
# REACT_APP_EMAILJS_PUBLIC_KEY=
